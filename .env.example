# ─── Database ───────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://youtilleyes:your_strong_password@localhost:5432/youtilleyes

# ─── Session / JWT ───────────────────────────────────────────────────────────
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_string

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
